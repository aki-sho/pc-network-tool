{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexaLink Monitor",
  "version": "1.1.0",
  "identifier": "com.example.pcnetworktool",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "NexaLink Monitor",
        "width": 1280,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "akisho",
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
