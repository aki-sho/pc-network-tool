{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Network Tool",
  "version": "1.0.1",
  "identifier": "com.example.pcnetworktool",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-frontend.ps1",
    "frontendDist": "../.tauri-frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "PC Network Tool",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
